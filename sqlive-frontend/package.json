{
    "name": "sqlive",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm run typecheck && vite build",
        "dev": "vite --host",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "pnpm run lint:script && pnpm run lint:style",
        "lint:fix": "oxlint --fix && pnpm run lint:style --fix",
        "lint:script": "oxlint",
        "lint:style": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
        "preview": "vite preview",
        "test": "vitest run",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.ts --project=chrome --project=edge",
        "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --project=chrome --project=edge --ui",
        "test:watch": "vitest",
        "typecheck": "vue-tsc -b tsconfig.app.json && node node_modules/@typescript/native/bin/tsc -b tsconfig.node.json"
    },
    "dependencies": {
        "@lucide/vue": "^1.48.0",
        "@scalar/api-reference": "^1.72.0",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/core": "^1.48.2",
        "@vue-flow/minimap": "^1.5.4",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dagre": "^0.8.5",
        "dompurify": "3.4.17",
        "echarts": "^6.1.0",
        "eventsource-parser": "^4.1.1",
        "marked": "^18.0.14",
        "minisearch": "^7.2.0",
        "monaco-editor": "^0.57.0",
        "motion-v": "^2.5.1",
        "nanoid": "^6.0.1",
        "ofetch": "1.5.1",
        "reka-ui": "^2.10.5",
        "splitpanes": "^4.1.2",
        "sql-formatter": "^15.9.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "vue-stick-to-bottom": "^1.0.1",
        "vue-stream-markdown": "^2.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/dagre": "^0.7.54",
        "@types/node": "^26.6.3",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "5.0.5",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.1",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "7.0.2006",
        "postcss-html": "2.0.0",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.5",
        "vue-tsc": "^3.3.14"
    },
    "packageManager": "pnpm@12.6.0"
}
